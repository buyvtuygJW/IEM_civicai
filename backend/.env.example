# Optional. If set, Welfare Copilot chat, complaint classification, and voice
# parsing all upgrade to use Claude for higher accuracy. Everything works
# offline with rule-based logic if you leave this unset.
ANTHROPIC_API_KEY=

# Secret used to sign login tokens (JWTs). Change this to a long random value
# before deploying anywhere real — the default is only safe for local demos.
JWT_SECRET=dev-secret-change-me-in-production

# Shared code required to register a government account, so random visitors
# can't self-register as officials. Change this before a real deployment —
# ideally replace the whole flow with SSO or admin approval instead.
GOV_REGISTRATION_CODE=CIVIC-GOV-2026

# Defaults to a local SQLite file. Point this at a real database when you
# outgrow SQLite, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/civicai
DATABASE_URL=sqlite:///./civicai.db
