# ── Bring your own AI key (recommended) ──────────────────────────────────
# Set ONE of these to unlock smarter Welfare Copilot chat, complaint
# classification, and voice parsing. Everything still works offline on
# rule-based logic if you leave all three blank — but accuracy is much better
# with a key. Priority if more than one is set: Anthropic, then OpenAI, then
# Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Gemini. Has a genuinely free tier -- grab a key at
# https://aistudio.google.com/apikey, no credit card required. Recommended if
# you just want a free prototype key. Also accepts GOOGLE_API_KEY.
GEMINI_API_KEY=

# Optional. Override the model. Defaults: claude-sonnet-5 (Anthropic) /
# gpt-4o-mini (OpenAI) / gemini-flash-latest (Gemini).
AI_MODEL=

# Secret used to sign login tokens (JWTs). Change this to a long random value
# before deploying anywhere real — the default is only safe for local demos.
JWT_SECRET=dev-secret-change-me-in-production

# Shared code required to register a government account, so random visitors
# can't self-register as officials. Change this before a real deployment —
# ideally replace the whole flow with SSO or admin approval instead.
GOV_REGISTRATION_CODE=CIVIC-GOV-2026

# Defaults to a local SQLite file. Point this at a real database when you
# outgrow SQLite, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/indicivicai
DATABASE_URL=sqlite:///./indicivicai.db
