# docker-compose automatically reads a file named ".env" in this same folder
# and substitutes these into docker-compose.yml. Copy this file to ".env" and
# fill in whatever you need — everything below has a safe default for a demo,
# so an empty .env (or no .env at all) still works.

# Optional. Enables Claude-powered classification, voice parsing, and Welfare
# Copilot chat. Leave blank to run entirely offline on rule-based logic.
ANTHROPIC_API_KEY=

# Secret used to sign login tokens (JWTs). Change this before deploying
# anywhere real — the default is only safe for local demos.
JWT_SECRET=dev-secret-change-me-in-production

# Shared code required to register a government account. Change this before
# a real deployment — ideally replace the whole flow with SSO/admin approval.
GOV_REGISTRATION_CODE=CIVIC-GOV-2026

# Defaults to local SQLite. Point at Postgres when you outgrow it, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/civicai
DATABASE_URL=sqlite:///./civicai.db
